---
import { defaultLocale, type Locale } from '@i18n/config';

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;

const labels =
  locale === 'fr'
    ? {
        aria: "Circuit de données : de l'agent de santé au service de formulaires, puis au laboratoire et à la biobanque",
        agent: 'Agent de santé',
        agentSub: 'Sentinelle · hors ligne',
        forms: 'FMS · service de formulaires',
        formsSub: 'NestJS · outbox transactionnel → Kafka',
        formsContract: "Contrat HTTP identique à l'ancien service",
        lab: 'Laboratoire',
        labSub: 'Fiches ↔ échantillons',
        biobank: 'Biobanque',
        biobankSub: 'Prélèvements conservés',
        admin: 'Form Admin',
        adminSub: 'Publier sans développeur',
        field: 'Terrain',
        formsShort: 'FMS',
        labShort: 'Labo',
      }
    : {
        aria: 'Data flow: from the health worker to the forms service, then to the laboratory and the biobank',
        agent: 'Health worker',
        agentSub: 'Sentinelle · offline',
        forms: 'FMS · forms service',
        formsSub: 'NestJS · transactional outbox → Kafka',
        formsContract: 'Same HTTP contract as the legacy service',
        lab: 'Laboratory',
        labSub: 'Forms ↔ samples',
        biobank: 'Biobank',
        biobankSub: 'Stored samples',
        admin: 'Form Admin',
        adminSub: 'Publish without a developer',
        field: 'Field',
        formsShort: 'FMS',
        labShort: 'Lab',
      };
---

<div class="flow-cover" role="img" aria-label={labels.aria}>
  <svg class="hidden lg:block w-full max-w-[460px] h-auto" viewBox="0 0 460 420" fill="none" aria-hidden="true">
    <rect class="flow-node" x="20" y="30" width="190" height="72" rx="10"></rect>
    <text class="flow-title" x="40" y="60">{labels.agent}</text>
    <text class="flow-sub" x="40" y="82">{labels.agentSub}</text>

    <path class="flow-edge" d="M115 102 V 150" stroke-dasharray="4 4"></path>
    <path class="flow-edge" d="M109 144 L115 152 L121 144"></path>

    <rect class="flow-node flow-node-key" x="20" y="156" width="420" height="96" rx="10"></rect>
    <text class="flow-title" x="40" y="186">{labels.forms}</text>
    <text class="flow-sub" x="40" y="208">{labels.formsSub}</text>
    <text class="flow-sub flow-accent" x="40" y="228">{labels.formsContract}</text>

    <path class="flow-edge" d="M115 252 V 300"></path>
    <path class="flow-edge" d="M109 294 L115 302 L121 294"></path>
    <path class="flow-edge" d="M345 252 V 300"></path>
    <path class="flow-edge" d="M339 294 L345 302 L351 294"></path>

    <rect class="flow-node" x="20" y="306" width="190" height="72" rx="10"></rect>
    <text class="flow-title" x="40" y="336">{labels.lab}</text>
    <text class="flow-sub" x="40" y="358">{labels.labSub}</text>

    <rect class="flow-node" x="250" y="306" width="190" height="72" rx="10"></rect>
    <text class="flow-title" x="270" y="336">{labels.biobank}</text>
    <text class="flow-sub" x="270" y="358">{labels.biobankSub}</text>

    <rect class="flow-node flow-node-ghost" x="250" y="30" width="190" height="72" rx="10" stroke-dasharray="4 4"></rect>
    <text class="flow-title" x="270" y="60">{labels.admin}</text>
    <text class="flow-sub" x="270" y="82">{labels.adminSub}</text>
    <path class="flow-edge flow-edge-muted" d="M345 102 V 150" stroke-dasharray="4 4"></path>
  </svg>

  <svg class="lg:hidden w-full max-w-[320px] h-auto" viewBox="0 0 320 130" fill="none" aria-hidden="true">
    <rect class="flow-node" x="4" y="44" width="88" height="42" rx="8"></rect>
    <text class="flow-title flow-title-sm" x="16" y="70">{labels.field}</text>
    <path class="flow-edge" d="M92 65 H 114" stroke-dasharray="3 3"></path>
    <rect class="flow-node flow-node-key" x="116" y="36" width="96" height="58" rx="8"></rect>
    <text class="flow-title flow-title-sm" x="128" y="62">{labels.formsShort}</text>
    <text class="flow-sub flow-accent flow-sub-sm" x="128" y="80">Kafka · outbox</text>
    <path class="flow-edge" d="M212 55 H 232"></path>
    <path class="flow-edge" d="M212 75 H 232"></path>
    <rect class="flow-node" x="234" y="20" width="82" height="42" rx="8"></rect>
    <text class="flow-title flow-title-sm" x="246" y="46">{labels.labShort}</text>
    <rect class="flow-node" x="234" y="70" width="82" height="42" rx="8"></rect>
    <text class="flow-title flow-title-sm" x="246" y="96">{labels.biobank}</text>
  </svg>
</div>

<style>
  .flow-cover {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  .flow-node {
    fill: var(--color-bg-secondary);
    stroke: var(--color-border-light);
  }

  .flow-node-key {
    stroke: var(--color-accent);
  }

  .flow-node-ghost {
    fill: var(--color-bg-primary);
  }

  .flow-title {
    fill: var(--color-text-primary);
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 600;
  }

  .flow-title-sm {
    font-size: 12px;
  }

  .flow-sub {
    fill: var(--color-text-secondary);
    font-family: var(--font-sans);
    font-size: 12px;
  }

  .flow-sub-sm {
    font-size: 10px;
  }

  .flow-accent {
    fill: var(--color-accent);
  }

  .flow-edge {
    stroke: var(--color-accent-light);
    stroke-width: 1.5;
  }

  .flow-edge-muted {
    stroke: var(--color-border-light);
  }
</style>
