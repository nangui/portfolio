---
import { defaultLocale, type Locale } from '@i18n/config';

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;

// Data flow: Sentinelle (field forms and samples) and Labo (specimens linked to a form) both send
// to FMS, which processes the data and forwards it to the biobank. Form Admin publishes the forms.
const labels =
  locale === 'fr'
    ? {
        aria: "Circuit de données : les fiches et échantillons saisis dans Sentinelle et les prélèvements rattachés à une fiche dans Labo sont envoyés à FMS, qui les traite et les transmet à la biobanque. Form Admin publie les formulaires.",
        field: 'Sentinelle · terrain',
        fieldSub: 'Fiches et échantillons',
        lab: 'Labo',
        labSub: 'Prélèvements → fiche',
        forms: 'FMS · service de formulaires',
        formsSub: 'NestJS · outbox transactionnel → Kafka',
        formsContract: "Contrat HTTP identique à l'ancien service",
        biobank: 'Biobanque',
        biobankSub: 'Reçoit via FMS',
        admin: 'Form Admin',
        adminSub: 'Publier sans développeur',
        fieldShort: 'Terrain',
        formsShort: 'FMS',
        labShort: 'Labo',
      }
    : {
        aria: 'Data flow: forms and samples entered in Sentinelle and specimens linked to a form in Labo are sent to FMS, which processes them and forwards them to the biobank. Form Admin publishes the forms.',
        field: 'Sentinelle · field',
        fieldSub: 'Forms and samples',
        lab: 'Labo',
        labSub: 'Specimens → form',
        forms: 'FMS · forms service',
        formsSub: 'NestJS · transactional outbox → Kafka',
        formsContract: 'Same HTTP contract as the legacy service',
        biobank: 'Biobank',
        biobankSub: 'Receives via FMS',
        admin: 'Form Admin',
        adminSub: 'Publish without a developer',
        fieldShort: 'Field',
        formsShort: 'FMS',
        labShort: 'Labo',
      };
---

<div class="flow-cover" role="img" aria-label={labels.aria}>
  <svg class="hidden lg:block w-full max-w-[460px] h-auto" viewBox="0 0 460 420" fill="none" aria-hidden="true">
    <!-- Clients: the field app (offline sync, dashed) and the lab app send to FMS -->
    <rect class="flow-node" x="20" y="30" width="190" height="72" rx="10"></rect>
    <text class="flow-title" x="40" y="60">{labels.field}</text>
    <text class="flow-sub" x="40" y="82">{labels.fieldSub}</text>
    <path class="flow-edge" d="M115 102 V 150" stroke-dasharray="4 4"></path>
    <path class="flow-edge" d="M109 144 L115 152 L121 144"></path>

    <rect class="flow-node" x="250" y="30" width="190" height="72" rx="10"></rect>
    <text class="flow-title" x="270" y="60">{labels.lab}</text>
    <text class="flow-sub" x="270" y="82">{labels.labSub}</text>
    <path class="flow-edge" d="M345 102 V 150"></path>
    <path class="flow-edge" d="M339 144 L345 152 L351 144"></path>

    <rect class="flow-node flow-node-key" x="20" y="156" width="420" height="96" rx="10"></rect>
    <text class="flow-title" x="40" y="186">{labels.forms}</text>
    <text class="flow-sub" x="40" y="208">{labels.formsSub}</text>
    <text class="flow-sub flow-accent" x="40" y="228">{labels.formsContract}</text>

    <!-- FMS forwards to the biobank -->
    <path class="flow-edge" d="M115 252 V 300"></path>
    <path class="flow-edge" d="M109 294 L115 302 L121 294"></path>
    <rect class="flow-node" x="20" y="306" width="190" height="72" rx="10"></rect>
    <text class="flow-title" x="40" y="336">{labels.biobank}</text>
    <text class="flow-sub" x="40" y="358">{labels.biobankSub}</text>

    <!-- Form Admin publishes the forms FMS serves -->
    <rect class="flow-node flow-node-ghost" x="250" y="306" width="190" height="72" rx="10" stroke-dasharray="4 4"></rect>
    <text class="flow-title" x="270" y="336">{labels.admin}</text>
    <text class="flow-sub" x="270" y="358">{labels.adminSub}</text>
    <path class="flow-edge flow-edge-muted" d="M345 306 V 258" stroke-dasharray="4 4"></path>
    <path class="flow-edge flow-edge-muted" d="M339 264 L345 256 L351 264"></path>
  </svg>

  <svg class="lg:hidden w-full max-w-[320px] h-auto" viewBox="0 0 320 130" fill="none" aria-hidden="true">
    <rect class="flow-node" x="4" y="20" width="88" height="42" rx="8"></rect>
    <text class="flow-title flow-title-sm" x="16" y="46">{labels.fieldShort}</text>
    <rect class="flow-node" x="4" y="70" width="88" height="42" rx="8"></rect>
    <text class="flow-title flow-title-sm" x="16" y="96">{labels.labShort}</text>
    <path class="flow-edge" d="M92 41 L 114 56" stroke-dasharray="3 3"></path>
    <path class="flow-edge" d="M92 91 L 114 76"></path>
    <rect class="flow-node flow-node-key" x="116" y="36" width="96" height="58" rx="8"></rect>
    <text class="flow-title flow-title-sm" x="128" y="62">{labels.formsShort}</text>
    <text class="flow-sub flow-accent flow-sub-sm" x="128" y="80">Kafka · outbox</text>
    <path class="flow-edge" d="M212 65 H 232"></path>
    <path class="flow-edge" d="M227 60 L 233 65 L 227 70"></path>
    <rect class="flow-node" x="234" y="44" width="82" height="42" rx="8"></rect>
    <text class="flow-title flow-title-sm" x="246" y="70">{labels.biobank}</text>
  </svg>
</div>

<style>
  .flow-cover {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  .flow-node {
    fill: var(--color-bg-secondary);
    stroke: var(--color-border-light);
  }

  .flow-node-key {
    stroke: var(--color-accent);
  }

  .flow-node-ghost {
    fill: var(--color-bg-primary);
  }

  .flow-title {
    fill: var(--color-text-primary);
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 600;
  }

  .flow-title-sm {
    font-size: 12px;
  }

  .flow-sub {
    fill: var(--color-text-secondary);
    font-family: var(--font-sans);
    font-size: 12px;
  }

  .flow-sub-sm {
    font-size: 10px;
  }

  .flow-accent {
    fill: var(--color-accent);
  }

  .flow-edge {
    stroke: var(--color-accent-light);
    stroke-width: 1.5;
  }

  .flow-edge-muted {
    stroke: var(--color-border-light);
  }
</style>
