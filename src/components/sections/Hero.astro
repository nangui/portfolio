---
import { getCollection, type CollectionEntry } from 'astro:content';
import Button from '@components/ui/Button.astro';
import { defaultLocale, type Locale } from '@i18n/config';
import { getTranslation } from '@i18n/translations';
import { formatPath } from '@i18n/utils';

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const heroIntro =
  locale === 'fr'
    ? "Transformer les idées en expériences web accessibles, du frontend au backend, jusqu'à la mise en production."
    : 'Transforming ideas into accessible web experiences, from frontend to backend, all the way to production.';
const portraitAlt = locale === 'fr' ? "Portrait d'Adonai Nangui" : 'Portrait of Adonai Nangui';
const recentMissionsLabel = locale === 'fr' ? 'Missions récentes' : 'Recent work';
const allProjectsLabel = locale === 'fr' ? 'Tous les projets' : 'All projects';

const recentMissionSummaries = [
  {
    slug: 'institut-pasteur-dakar',
    fr: 'Plateforme de surveillance épidémiologique, en service dans 10 pays',
    en: 'Epidemiological surveillance platform, running in 10 countries',
  },
  {
    slug: 'gebeya',
    fr: 'SaaS multi-tenant, 13 micro-frontends orchestrés via Single-SPA',
    en: 'Multi-tenant SaaS, 13 micro-frontends orchestrated with Single-SPA',
  },
  {
    slug: 'djoubo',
    fr: 'Réservation de véhicules avec chauffeur, web et mobile',
    en: 'Chauffeured vehicle booking, web and mobile',
  },
];

const allProjects = (await getCollection('projects').catch(() => [])) as CollectionEntry<'projects'>[];

const getBaseSlug = (entry: CollectionEntry<'projects'>): string => {
  if (entry.data.slug) return entry.data.slug.replace(/-(fr|en)$/, '');
  const filename = entry.id.split('/').pop() || entry.id;
  return filename.replace(/\.(fr|en)\.(md|mdx)$/, '').replace(/\.(md|mdx)$/, '');
};

const findProject = (slug: string): CollectionEntry<'projects'> | undefined =>
  allProjects.find((project) => project.data.slug === `${slug}-${locale}`) ??
  allProjects.find((project) => getBaseSlug(project) === slug);

const recentMissions = recentMissionSummaries.flatMap((mission) => {
  const project = findProject(mission.slug);
  if (!project) return [];

  const title =
    locale === 'fr'
      ? project.data.title_fr || project.data.title || ''
      : project.data.title_en || project.data.title || '';
  const period =
    locale === 'fr'
      ? project.data.period_fr || project.data.period || ''
      : project.data.period_en || project.data.period || '';

  return [
    {
      slug: mission.slug,
      name: title.split(' - ')[0],
      period: period.replace(' - ', ' – '),
      summary: mission[locale],
      href: formatPath(`/projects/${mission.slug}`, locale),
    },
  ];
});
---

<section id="hero" class="bg-primary" aria-labelledby="hero-heading">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-14 md:pt-20 md:pb-20 lg:pt-24">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
      <div class="min-w-0">
        <div class="flex items-center gap-3.5 sm:gap-4 mb-6 sm:mb-7">
          <figure class="hero-portrait" aria-label={portraitAlt}>
            <span class="hero-portrait-crop">
              <img
                src="/hero-image.jpeg"
                alt={portraitAlt}
                width="144"
                height="144"
                loading="eager"
                decoding="async"
                class="hero-portrait-image"
              />
            </span>
          </figure>
          <div class="flex flex-col gap-0.5">
            <p class="font-heading text-[17px] sm:text-lg font-semibold text-primary">
              {getTranslation('hero', 'name', locale)}
            </p>
            <p class="text-[13px] sm:text-sm text-secondary">
              {getTranslation('hero', 'title', locale)}
            </p>
          </div>
        </div>

        <h1
          id="hero-heading"
          class="hero-heading font-heading font-semibold text-primary text-[2.375rem] sm:text-5xl lg:text-[4rem] mb-4 sm:mb-6"
        >
          {getTranslation('hero', 'tagline', locale)}
        </h1>

        <p class="text-base sm:text-lg text-secondary leading-relaxed max-w-[460px] mb-7 sm:mb-9">
          {heroIntro}
        </p>

        <div class="flex flex-col sm:flex-row gap-3 justify-start">
          <Button
            href="#projects"
            variant="primary"
            size="lg"
            class="hero-primary-btn"
            ariaLabel={getTranslation('hero', 'ctaProjects', locale)}
            analyticsEvent="hero_cta_click"
            analyticsLabel="projects"
          >
            {getTranslation('hero', 'ctaProjects', locale)}
          </Button>
          <Button
            href="#contact"
            variant="secondary"
            size="lg"
            class="hero-secondary-btn"
            ariaLabel={getTranslation('hero', 'ctaContact', locale)}
            analyticsEvent="hero_cta_click"
            analyticsLabel="contact"
          >
            {getTranslation('hero', 'ctaContact', locale)}
          </Button>
        </div>
      </div>

      {recentMissions.length > 0 && (
        <div class="rounded-xl border border-border-default bg-secondary py-1 sm:py-2">
          <p
            id="hero-missions-label"
            class="px-[18px] sm:px-6 pt-3.5 sm:pt-4 pb-2.5 sm:pb-3 text-xs font-semibold uppercase tracking-[0.08em] text-[var(--color-text-tertiary)]"
          >
            {recentMissionsLabel}
          </p>
          <ul aria-labelledby="hero-missions-label" role="list">
            {recentMissions.map((mission) => (
              <li class="border-t border-border-default">
                <a
                  href={mission.href}
                  class="hero-mission group flex items-center justify-between gap-4 px-[18px] sm:px-6 py-4 sm:py-5 focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-accent"
                  data-analytics-event="hero_recent_mission_click"
                  data-analytics-label={mission.slug}
                >
                  <span class="flex flex-col gap-1 sm:gap-1.5 min-w-0">
                    <span class="text-xs sm:text-[13px] text-[var(--color-text-tertiary)]">{mission.period}</span>
                    <span class="font-heading text-lg sm:text-xl font-semibold text-primary">{mission.name}</span>
                    <span class="text-sm leading-normal text-secondary">{mission.summary}</span>
                  </span>
                  <svg
                    class="shrink-0 text-accent-light transition-transform group-hover:translate-x-0.5"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M5 12h14M13 6l6 6-6 6"></path>
                  </svg>
                </a>
              </li>
            ))}
            <li class="border-t border-border-default">
              <a
                href="#projects"
                class="flex items-center min-h-12 px-[18px] sm:px-6 text-sm font-medium text-accent hover:text-accent-hover focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-accent"
                data-analytics-event="hero_cta_click"
                data-analytics-label="all_projects"
              >
                {allProjectsLabel} →
              </a>
            </li>
          </ul>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .hero-heading {
    line-height: 1.02;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .hero-portrait {
    width: 64px;
    height: 64px;
    margin: 0;
    flex: 0 0 auto;
    padding: 4px;
    border-radius: 42% 58% 52% 48% / 46% 45% 55% 54%;
    background: #facc15;
  }

  .hero-portrait-crop {
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 46% 54% 48% 52% / 49% 46% 54% 51%;
    background: var(--color-bg-secondary);
  }

  /* The source photo has a wide backdrop: zoom in so the face reads at avatar size */
  .hero-portrait-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.75);
    transform-origin: 50% 42%;
    filter: grayscale(1) contrast(1.03);
  }

  @media (min-width: 640px) {
    .hero-portrait {
      width: 72px;
      height: 72px;
    }

    .hero-heading {
      line-height: 1;
    }
  }

  .hero-mission:hover {
    background: var(--color-bg-tertiary);
  }

  :global(.hero-primary-btn) {
    background: #3b82f6;
    color: #f8fbff;
    border: 2px solid #9ec5ff;
    border-radius: 28px 14px 32px 12px / 14px 30px 12px 28px;
    box-shadow:
      inset 0 0 0 1px rgba(11, 25, 44, 0.26),
      0 7px 18px rgba(0, 0, 0, 0.22);
  }

  :global(.hero-primary-btn:hover) {
    background: #2563eb;
    border-color: #d5e6ff;
  }

  :global(.hero-secondary-btn) {
    background: var(--color-bg-secondary);
    border: 2px solid color-mix(in srgb, var(--color-accent-light) 60%, #ffffff 40%);
    color: var(--color-text-primary);
    border-radius: 26px 12px 30px 16px / 15px 28px 16px 30px;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-bg-primary) 45%, transparent);
  }

  :global(.hero-secondary-btn:hover) {
    background: color-mix(in srgb, var(--color-bg-secondary) 82%, #111827 18%);
    border-color: color-mix(in srgb, var(--color-accent-light) 45%, var(--color-border-light) 55%);
  }

  @media (max-width: 767px) {
    :global(.hero-primary-btn),
    :global(.hero-secondary-btn) {
      border-radius: 22px 12px 24px 14px / 12px 24px 13px 22px;
    }
  }
</style>
