---
import { defaultLocale, type Locale } from '@i18n/config';
import { getTranslation } from '@i18n/translations';

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;

const experiences = [
  { key: 'masskode', company: 'MassKode', impactCount: 5 },
  { key: 'djoubo', company: 'Djoubo', impactCount: 5 },
  { key: 'gebeya-senior', company: 'Gebeya Inc', impactCount: 4 },
  { key: 'socium', company: 'Socium', impactCount: 4 },
  { key: 'sonatel', company: 'Sonatel', impactCount: 4 },
  { key: 'gebeya-fullstack', company: 'Gebeya Inc', impactCount: 4 },
];

const getExperienceData = (exp: (typeof experiences)[0], currentLocale: Locale) => {
  const role = getTranslation('experience', `${exp.key}.role`, currentLocale);
  const period = getTranslation('experience', `${exp.key}.period`, currentLocale);
  const impacts: string[] = [];

  for (let i = 1; i <= exp.impactCount; i += 1) {
    const impact = getTranslation('experience', `${exp.key}.impact${i}`, currentLocale);
    if (impact && impact !== `${exp.key}.impact${i}`) impacts.push(impact);
  }

  return {
    role,
    period: period.replace(' - ', ' – '),
    isCurrent: /présent|present/i.test(period),
    company: exp.company,
    impacts,
  };
};

// Kept for structured data only: the visible keyword list was removed from the section
const expertiseKeywords = locale === 'fr'
  ? [
      'Senior Frontend Engineer',
      'Tech Lead',
      'React',
      'Vue.js',
      'Angular',
      'Next.js',
      'TypeScript',
      'NestJS',
      'Laravel',
      'Développement backend',
      'Micro-Frontend',
      'Module Federation',
      'Accessibilité Web',
      'Performance Web',
      'Architecture logicielle',
    ]
  : [
      'Senior Frontend Engineer',
      'Tech Lead',
      'React',
      'Vue.js',
      'Angular',
      'Next.js',
      'TypeScript',
      'NestJS',
      'Laravel',
      'Backend Development',
      'Micro Frontend',
      'Module Federation',
      'Web Accessibility',
      'Web Performance',
      'Software Architecture',
    ];

// Impacts shown before the "show more" toggle
const visibleImpactCount = 3;
const currentLabel = locale === 'fr' ? 'En cours' : 'Current';
const lessLabel = locale === 'fr' ? 'Voir moins' : 'Show less';
const getMoreLabel = (count: number): string => {
  if (locale === 'fr') return `+ ${count} ${count > 1 ? 'autres réalisations' : 'autre réalisation'}`;
  return `+ ${count} more ${count > 1 ? 'achievements' : 'achievement'}`;
};
---

<section id="experience" class="py-section bg-primary" aria-labelledby="experience-heading">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
    <h2 id="experience-heading" class="font-heading font-semibold text-3xl md:text-4xl text-primary mb-7 md:mb-10">
      {getTranslation('experience', 'heading', locale)}
    </h2>

    <ol class="border-t border-border-default" role="list">
      {experiences.map((exp) => {
        const expData = getExperienceData(exp, locale);
        const visibleImpacts = expData.impacts.slice(0, visibleImpactCount);
        const hiddenImpacts = expData.impacts.slice(visibleImpactCount);
        return (
          <li class="grid grid-cols-1 md:grid-cols-[260px_minmax(0,1fr)] gap-2.5 md:gap-12 border-b border-border-default py-6 md:py-8">
            <div class="flex flex-wrap md:flex-col items-center md:items-start gap-2 md:gap-1.5">
              <p class="text-[13px] text-text-tertiary">{expData.period}</p>
              <p class="hidden md:block font-heading text-lg font-semibold text-primary">{expData.company}</p>
              {expData.isCurrent && (
                <p class="md:mt-1 rounded-full border border-accent-light/40 px-2.5 py-0.5 text-xs font-semibold text-accent">
                  {currentLabel}
                </p>
              )}
            </div>

            <article class="flex flex-col gap-2.5 md:gap-3.5">
              <h3 class="font-heading text-xl md:text-[22px] font-semibold text-primary">
                {expData.role}
                <span class="md:hidden block mt-1 font-sans text-[15px] font-medium text-secondary">{expData.company}</span>
              </h3>

              {visibleImpacts.length > 0 && (
                <ul class="flex flex-col gap-2 md:gap-2.5">
                  {visibleImpacts.map((impact) => (
                    <li class="flex items-start gap-2.5 md:gap-3 text-sm md:text-[15px] leading-relaxed text-secondary">
                      <span class="mt-2 h-1.5 w-1.5 rounded-full bg-accent shrink-0" aria-hidden="true"></span>
                      <span>{impact}</span>
                    </li>
                  ))}
                </ul>
              )}

              {hiddenImpacts.length > 0 && (
                <details class="experience-more">
                  <summary class="flex min-h-11 md:min-h-0 w-fit cursor-pointer items-center text-sm font-medium text-accent hover:text-accent-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">
                    <span class="experience-more-label">{getMoreLabel(hiddenImpacts.length)}</span>
                    <span class="experience-less-label">{lessLabel}</span>
                  </summary>
                  <ul class="mt-2 md:mt-3 flex flex-col gap-2 md:gap-2.5">
                    {hiddenImpacts.map((impact) => (
                      <li class="flex items-start gap-2.5 md:gap-3 text-sm md:text-[15px] leading-relaxed text-secondary">
                        <span class="mt-2 h-1.5 w-1.5 rounded-full bg-accent shrink-0" aria-hidden="true"></span>
                        <span>{impact}</span>
                      </li>
                    ))}
                  </ul>
                </details>
              )}
            </article>
          </li>
        );
      })}
    </ol>
  </div>

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: 'Adonai Nangui',
      hasOccupation: experiences.map((exp) => ({
        '@type': 'Occupation',
        name: getTranslation('experience', `${exp.key}.role`, locale),
        occupationalCategory: 'Software Engineering',
      })),
      knowsAbout: expertiseKeywords,
    })}
  />
</section>

<style>
  .experience-more summary {
    list-style: none;
  }

  .experience-more summary::-webkit-details-marker {
    display: none;
  }

  .experience-less-label,
  .experience-more[open] .experience-more-label {
    display: none;
  }

  .experience-more[open] .experience-less-label {
    display: inline;
  }
</style>
