---
import { defaultLocale, type Locale } from '@i18n/config';
import { getTranslation } from '@i18n/translations';

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const availabilityLabel =
  locale === 'fr' ? 'Disponible pour de nouvelles missions' : 'Available for new engagements';
const responsePromise =
  locale === 'fr' ? 'Réponse en moins de 24 heures ouvrées' : 'Response in less than 24 business hours';
const sendLabel = locale === 'fr' ? 'Envoyer un message' : 'Send a message';
const emailAddress = 'adonainangui03@gmail.com';

const socialLinks = [
  { key: 'linkedin', href: 'https://linkedin.com/in/adonai-nangui' },
  { key: 'github', href: 'https://github.com/nangui' },
];
---

<section id="contact" class="py-section bg-primary" aria-labelledby="contact-heading">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 items-center gap-8 lg:gap-14 rounded-2xl border border-border-default bg-secondary p-5 sm:p-10 lg:p-14">
      <div class="flex flex-col gap-4 md:gap-[18px]">
        <p class="flex w-fit items-center gap-2 rounded-full border border-border-default bg-primary px-3 md:px-3.5 py-1.5 text-xs md:text-[13px] font-medium text-secondary">
          <span class="h-2 w-2 rounded-full bg-accent" aria-hidden="true"></span>
          {availabilityLabel}
        </p>
        <h2 id="contact-heading" class="font-heading font-semibold text-4xl lg:text-[52px] leading-[1.05] tracking-[-0.02em] text-primary">
          {getTranslation('contact', 'heading', locale)}
        </h2>
        <p class="text-base md:text-lg leading-relaxed text-secondary">
          {getTranslation('contact', 'description', locale)}
        </p>
        <ul class="mt-1.5 flex flex-col gap-2.5 text-[13px] md:text-sm text-secondary" role="list">
          <li class="flex items-center gap-2.5">
            <svg class="shrink-0 text-accent" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 21s-7-6.2-7-11a7 7 0 1 1 14 0c0 4.8-7 11-7 11z"></path>
              <circle cx="12" cy="10" r="2.5"></circle>
            </svg>
            {getTranslation('contact', 'location', locale)}
          </li>
          <li class="flex items-center gap-2.5">
            <svg class="shrink-0 text-accent" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="9"></circle>
              <path d="M12 7v5l3 2"></path>
            </svg>
            {responsePromise}
          </li>
        </ul>
      </div>

      <div class="flex flex-col gap-3">
        <div class="flex flex-col gap-1.5 md:gap-2 rounded-xl border border-accent bg-primary p-[18px] md:p-7">
          <p class="text-xs font-semibold uppercase tracking-[0.08em] text-text-tertiary">
            {getTranslation('contact', 'emailLabel', locale)}
          </p>
          <p class="font-heading text-[17px] md:text-[22px] font-semibold text-primary [overflow-wrap:anywhere]">
            {emailAddress}
          </p>
          <a
            href={`mailto:${emailAddress}`}
            class="contact-cta mt-2.5 md:mt-3 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
            data-analytics-event="contact_click"
            data-analytics-label="email"
          >
            {sendLabel}
          </a>
        </div>

        <ul class="grid grid-cols-2 gap-2.5 md:gap-3" role="list">
          {socialLinks.map((link) => {
            const label = getTranslation('contact', `${link.key}Label`, locale);
            const description = getTranslation('contact', `${link.key}Description`, locale);
            return (
              <li>
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex h-full min-h-[52px] items-center justify-between gap-3 rounded-xl border border-border-default bg-primary px-4 md:px-5 py-3 md:py-[18px] hover:border-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
                  aria-label={`${label} - ${description}`}
                  data-analytics-event="contact_click"
                  data-analytics-label={link.key}
                  data-no-external-icon
                >
                  <span class="flex flex-col gap-0.5">
                    <span class="font-heading text-base md:text-[17px] font-semibold text-primary group-hover:text-accent">{label}</span>
                    <span class="hidden md:block text-[13px] text-secondary">{description}</span>
                  </span>
                  <svg class="shrink-0 text-accent-light" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M7 17L17 7M9 7h8v8"></path>
                  </svg>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: flex-start;
    padding: 0.75rem 1.5rem;
    font-size: 1rem;
    font-weight: 500;
    background: #3b82f6;
    color: #f8fbff;
    border: 2px solid #9ec5ff;
    border-radius: 28px 14px 32px 12px / 14px 30px 12px 28px;
  }

  .contact-cta:hover {
    background: #2563eb;
    border-color: #d5e6ff;
    color: #f8fbff;
  }

  @media (max-width: 639px) {
    .contact-cta {
      align-self: stretch;
      min-height: 52px;
      border-radius: 22px 12px 24px 14px / 12px 24px 13px 22px;
    }
  }
</style>
