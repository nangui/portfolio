---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import sharp from 'sharp';
import path from 'node:path';

interface Props {
  src: string | ImageMetadata;
  alt: string;
  class?: string;
  width?: number;
  height?: number;
  widths?: number[];
  sizes?: string;
  loading?: 'lazy' | 'eager';
  quality?: number;
}

const {
  src,
  alt,
  class: className = '',
  width,
  height,
  widths,
  sizes,
  loading = 'lazy',
  quality = 80
} = Astro.props;

// Type guard to check if src is an ImageMetadata (imported asset)
const isImageMetadata = (src: string | ImageMetadata): src is ImageMetadata => {
  return typeof src === 'object' && src !== null && 'src' in src && 'width' in src && 'format' in src;
};

// Images in public/ must be given width and height. Read the real dimensions at build time
// so the image service only resizes (same aspect ratio, never cropped).
const getPublicImageSize = async (publicPath: string): Promise<{ width: number; height: number } | null> => {
  try {
    const metadata = await sharp(path.join(process.cwd(), 'public', publicPath)).metadata();
    return metadata.width && metadata.height ? { width: metadata.width, height: metadata.height } : null;
  } catch {
    return null;
  }
};

const isPublicPath = typeof src === 'string' && src.startsWith('/') && !src.startsWith('//');
const publicSize = isPublicPath && !(width && height) ? await getPublicImageSize(src as string) : null;
const resolvedWidth = width ?? publicSize?.width;
const resolvedHeight = height ?? publicSize?.height;
---

{isImageMetadata(src) ? (
  <Image
    src={src}
    alt={alt}
    class={className}
    loading={loading}
    quality={quality}
    {...(width && { width })}
    {...(height && { height })}
    {...(widths && { widths })}
    {...(sizes && { sizes })}
  />
) : isPublicPath && resolvedWidth && resolvedHeight ? (
  <Image
    src={src}
    alt={alt}
    class={className}
    loading={loading}
    quality={quality}
    width={resolvedWidth}
    height={resolvedHeight}
    {...(widths && { widths })}
    {...(sizes && { sizes })}
  />
) : (
  <img
    src={src}
    alt={alt}
    class={className}
    loading={loading}
    decoding="async"
    {...(width && { width })}
    {...(height && { height })}
  />
)}
