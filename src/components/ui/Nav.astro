---
import LanguageSwitcher from '@components/i18n/LanguageSwitcher.astro';
import ThemeToggle from '@components/ui/ThemeToggle.astro';
import { defaultLocale, locales, localeCodes, offerLocale, type Locale } from '@i18n/config';
import { getTranslation } from '@i18n/translations';
import { formatPath, getLocaleSwitchPath } from '@i18n/utils';

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;

// "Home" is reached through the name, "Contact" is the call-to-action button.
// The blog stays reachable from its home page section and the footer, not from the main menu.
const navItems: Array<{ key: string; href: string; section?: string; homeHref?: string; hreflang?: Locale }> = [
  { key: 'offer', href: '/offre', hreflang: locale === offerLocale ? undefined : offerLocale },
  { key: 'projects', href: '#projects', section: 'projects' },
  { key: 'experience', href: '#experience', section: 'experience' },
];

const openMenuLabel = getTranslation('nav', 'openMenu', locale);
const closeMenuLabel = getTranslation('nav', 'closeMenu', locale);
const navLabel = locale === 'fr' ? 'Navigation principale' : 'Main navigation';
const contactLabel = getTranslation('hero', 'ctaContact', locale);
const themeLabel = locale === 'fr' ? 'Thème' : 'Theme';
const languageLabel = locale === 'fr' ? 'Langue' : 'Language';
const currentPathname = Astro.url.pathname;
const homePath = formatPath('/', locale);

const normalizePath = (path: string): string => {
  if (path !== '/' && path.endsWith('/')) return path.slice(0, -1);
  return path;
};

const isSectionLink = (href: string): boolean => href.startsWith('#');

const isHomeRoute = normalizePath(currentPathname) === normalizePath(homePath);
const isProjectRoute = /\/projects\//.test(currentPathname);

const buildHref = (href: string, homeHref?: string): string => {
  if (isHomeRoute && homeHref) return homeHref;
  if (isHomeRoute && isSectionLink(href)) return href;
  if (isSectionLink(href)) {
    return `${homePath}/${href}`;
  }
  return formatPath(href, locale);
};

const isActivePath = (href: string): boolean => {
  if (isSectionLink(href)) return false;
  const target = normalizePath(formatPath(href, locale));
  const current = normalizePath(currentPathname);
  return current === target || current.startsWith(`${target}/`);
};

// On the home page the section spy decides; elsewhere highlight the matching page
const isItemActive = (item: (typeof navItems)[number]): boolean => {
  if (isHomeRoute) return false;
  if (item.key === 'projects') return isProjectRoute;
  if (item.key === 'offer') return normalizePath(currentPathname) === `/${offerLocale}/offre`;
  return isActivePath(item.href);
};

const contactHref = buildHref('#contact');
---

<nav
  class="site-nav sticky top-0 z-40 border-b"
  aria-label={navLabel}
  data-home-path={normalizePath(homePath)}
  data-scrolled="false"
>
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="h-16 md:h-[72px] flex items-center justify-between gap-6">
      <a
        href={formatPath('/', locale)}
        class="font-heading text-lg font-semibold tracking-tight text-primary hover:text-accent rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        aria-label="Adonai Nangui"
      >
        Adonai Nangui
      </a>

      <div class="hidden md:flex items-center gap-7">
        <ul class="flex items-center gap-7">
          {navItems.map((item) => {
            const active = isItemActive(item);
            return (
              <li>
                <a
                  href={item.key === 'offer' ? formatPath(item.href, offerLocale) : buildHref(item.href, item.homeHref)}
                  hreflang={item.hreflang}
                  data-nav-link="true"
                  data-section={item.section}
                  data-active={active ? 'true' : 'false'}
                  class="nav-link-desktop block py-2 text-sm font-medium focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
                  aria-current={active ? 'page' : undefined}
                >
                  {getTranslation('nav', item.key, locale)}{item.hreflang && ' (FR)'}
                </a>
              </li>
            );
          })}
        </ul>

        <span class="h-5 w-px bg-border-light" aria-hidden="true"></span>

        <div class="flex items-center gap-1">
          <ThemeToggle />
          <LanguageSwitcher currentLocale={locale} currentPath={Astro.url.pathname} />
        </div>

        <a
          href={contactHref}
          class="nav-cta focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          data-analytics-event="nav_cta_click"
          data-analytics-label="contact"
        >
          {contactLabel}
        </a>
      </div>

      <button
        type="button"
        class="md:hidden -mr-2 inline-flex h-11 w-11 items-center justify-center rounded-sm text-secondary hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        aria-label={openMenuLabel}
        aria-expanded="false"
        aria-controls="mobile-menu"
        id="mobile-menu-button"
        data-open-label={openMenuLabel}
        data-close-label={closeMenuLabel}
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden md:hidden fixed inset-x-0 top-16 bottom-0 overflow-y-auto bg-primary">
    <div class="flex min-h-full flex-col px-4 sm:px-6 pt-6 pb-8">
      <ul class="flex flex-col">
        {navItems.map((item) => {
          const active = isItemActive(item);
          return (
            <li>
              <a
                href={item.key === 'offer' ? formatPath(item.href, offerLocale) : buildHref(item.href, item.homeHref)}
                hreflang={item.hreflang}
                data-nav-link="true"
                data-section={item.section}
                data-active={active ? 'true' : 'false'}
                class="nav-link-mobile flex min-h-16 items-center justify-between border-b border-border-default font-heading text-[28px] font-semibold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
                aria-current={active ? 'page' : undefined}
              >
                {getTranslation('nav', item.key, locale)}{item.hreflang && ' (FR)'}
                <span class="nav-dot h-2 w-2 rounded-full bg-accent" aria-hidden="true"></span>
              </a>
            </li>
          );
        })}
      </ul>

      <div class="mt-auto flex flex-col gap-4 pt-10">
        <a
          href={contactHref}
          class="nav-cta nav-cta-mobile focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          data-analytics-event="nav_cta_click"
          data-analytics-label="contact_mobile"
        >
          {contactLabel}
        </a>

        <div class="flex flex-wrap items-center justify-between gap-3">
          <div class="flex rounded-full border border-border-default p-1" role="group" aria-label={languageLabel}>
            {locales.map((targetLocale) => (
              <a
                href={getLocaleSwitchPath(currentPathname, targetLocale)}
                hreflang={targetLocale}
                class="lang-segment flex h-9 min-w-[52px] items-center justify-center rounded-full text-[13px] font-semibold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
                aria-current={targetLocale === locale ? 'true' : undefined}
              >
                {localeCodes[targetLocale]}
              </a>
            ))}
          </div>

          <div class="flex items-center gap-1 rounded-full border border-border-default pl-4 pr-1 text-sm text-secondary">
            <span>{themeLabel}</span>
            <ThemeToggle />
          </div>
        </div>
      </div>
    </div>
  </div>
</nav>

<style>
  .site-nav {
    background-color: transparent;
    border-bottom-color: transparent;
    transition-property: background-color, border-color;
    transition-duration: 160ms;
  }

  /* No backdrop-filter here: it would become the containing block of the fixed mobile menu */
  .site-nav[data-scrolled='true'],
  .site-nav:has(#mobile-menu:not(.hidden)) {
    background-color: color-mix(in srgb, var(--color-bg-primary) 94%, transparent);
    border-bottom-color: color-mix(in srgb, var(--color-border-default) 70%, transparent);
  }

  .nav-link-desktop {
    border-bottom: 2px solid transparent;
  }

  .nav-link-desktop[data-active='true'] {
    color: var(--color-text-primary);
    border-bottom-color: var(--color-accent);
  }

  .nav-link-desktop[data-active='false'] {
    color: var(--color-text-secondary);
  }

  .nav-link-desktop[data-active='false']:hover {
    color: var(--color-text-primary);
  }

  .nav-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 1.125rem;
    font-size: 0.875rem;
    font-weight: 500;
    white-space: nowrap;
    background: #2563eb;
    color: #f8fbff;
    border: 2px solid #9ec5ff;
    border-radius: 20px 10px 22px 9px / 10px 21px 9px 20px;
  }

  .nav-cta:hover {
    background: #1d4ed8;
    border-color: #d5e6ff;
    color: #f8fbff;
  }

  .nav-cta-mobile {
    min-height: 52px;
    font-size: 1rem;
    border-radius: 22px 12px 24px 14px / 12px 24px 13px 22px;
  }

  .nav-link-mobile[data-active='true'] {
    color: var(--color-text-primary);
  }

  .nav-link-mobile[data-active='false'] {
    color: var(--color-text-secondary);
  }

  .nav-link-mobile[data-active='false']:hover {
    color: var(--color-text-primary);
  }

  .nav-link-mobile[data-active='false'] .nav-dot {
    display: none;
  }

  .lang-segment {
    color: var(--color-text-secondary);
  }

  .lang-segment[aria-current='true'] {
    background: var(--color-bg-tertiary);
    color: var(--color-text-primary);
  }
</style>

<script>
  let controller: AbortController | null = null;

  const setLinkState = (link: Element, active: boolean) => {
    link.setAttribute('data-active', active ? 'true' : 'false');
    if (active) {
      link.setAttribute('aria-current', 'page');
    } else {
      link.removeAttribute('aria-current');
    }
  };

  const initScrolledState = (signal: AbortSignal) => {
    const navElement = document.querySelector('nav[data-home-path]');
    if (!navElement) return;

    const update = () => {
      navElement.setAttribute('data-scrolled', window.scrollY > 8 ? 'true' : 'false');
    };

    update();
    window.addEventListener('scroll', update, { signal, passive: true });
  };

  const initSectionSpy = (signal: AbortSignal) => {
    const navElement = document.querySelector('nav[data-home-path]');
    if (!navElement) return;

    const homePath = navElement.getAttribute('data-home-path') || '';
    const normalizePath = (path: string) => (path !== '/' && path.endsWith('/') ? path.slice(0, -1) : path);
    if (normalizePath(window.location.pathname) !== homePath) return;

    const sectionLinks = Array.from(document.querySelectorAll('a[data-nav-link][data-section]'));
    if (sectionLinks.length === 0) return;

    const sectionIds = Array.from(
      new Set(
        sectionLinks
          .map((link) => link.getAttribute('data-section'))
          .filter((value): value is string => Boolean(value))
      )
    );

    // The hero has no link: observing it clears the highlight when scrolling back to the top
    const sections = [...sectionIds, 'hero']
      .map((id) => document.getElementById(id))
      .filter((section): section is HTMLElement => Boolean(section));
    if (sections.length === 0) return;

    const activateSection = (id: string) => {
      sectionLinks.forEach((link) => {
        setLinkState(link, link.getAttribute('data-section') === id);
      });
    };

    const activateFromHash = (): boolean => {
      const id = window.location.hash.replace('#', '');
      if (!id || !sectionIds.includes(id)) return false;
      activateSection(id);
      return true;
    };

    if (!activateFromHash()) activateSection('hero');

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio);

        if (visible.length === 0) return;
        const currentId = (visible[0].target as HTMLElement).id;
        if (currentId) activateSection(currentId);
      },
      {
        rootMargin: '-38% 0px -50% 0px',
        threshold: [0.1, 0.35, 0.6],
      }
    );

    sections.forEach((section) => observer.observe(section));
    signal.addEventListener('abort', () => observer.disconnect(), { once: true });

    sectionLinks.forEach((link) => {
      link.addEventListener(
        'click',
        () => {
          const id = link.getAttribute('data-section');
          if (id) activateSection(id);
        },
        { signal }
      );
    });

    window.addEventListener('hashchange', () => {
      activateFromHash();
    }, { signal });
  };

  const initMobileMenu = (signal: AbortSignal) => {
    const menuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    if (!menuButton || !mobileMenu) return;

    const icon = menuButton.querySelector('svg');
    const openLabel = menuButton.getAttribute('data-open-label') || 'Open navigation menu';
    const closeLabel = menuButton.getAttribute('data-close-label') || 'Close navigation menu';

    const renderIcon = (open: boolean) => {
      if (!icon) return;
      icon.innerHTML = open
        ? '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 6l12 12M18 6l-12 12"></path>'
        : '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7h16M4 12h16M4 17h16"></path>';
    };

    const setOpen = (open: boolean) => {
      mobileMenu.classList.toggle('hidden', !open);
      menuButton.setAttribute('aria-expanded', String(open));
      menuButton.setAttribute('aria-label', open ? closeLabel : openLabel);
      document.body.style.overflow = open ? 'hidden' : '';
      renderIcon(open);
    };

    const isOpen = () => !mobileMenu.classList.contains('hidden');

    menuButton.addEventListener('click', () => setOpen(!isOpen()), { signal });

    mobileMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false), { signal });
    });

    document.addEventListener(
      'keydown',
      (event) => {
        if (event.key === 'Escape' && isOpen()) {
          setOpen(false);
          menuButton.focus();
        }
      },
      { signal }
    );

    window.addEventListener(
      'resize',
      () => {
        if (isOpen() && window.matchMedia('(min-width: 768px)').matches) setOpen(false);
      },
      { signal, passive: true }
    );
  };

  const initNav = () => {
    controller?.abort();
    controller = new AbortController();
    const signal = controller.signal;
    initScrolledState(signal);
    initMobileMenu(signal);
    initSectionSpy(signal);
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initNav, { once: true });
  } else {
    initNav();
  }

  document.addEventListener('astro:page-load', initNav);
</script>
