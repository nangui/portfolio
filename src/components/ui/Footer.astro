---
import { defaultLocale, type Locale } from '@i18n/config';
import { getTranslation } from '@i18n/translations';
import { formatPath } from '@i18n/utils';

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;

const homePath = formatPath('/', locale);
const navLinks = [
  { key: 'projects', href: `${homePath}#projects` },
  { key: 'experience', href: `${homePath}#experience` },
  { key: 'blog', href: formatPath('/blog', locale) },
  { key: 'contact', href: `${homePath}#contact` },
];

const socialLinks = [
  { key: 'linkedin', href: 'https://linkedin.com/in/adonai-nangui' },
  { key: 'github', href: 'https://github.com/nangui' },
];

const currentYear = new Date().getFullYear();
const copyright = getTranslation('footer', 'copyright', locale);
const footerNavLabel = locale === 'fr' ? 'Navigation du pied de page' : 'Footer navigation';
const socialNavLabel = locale === 'fr' ? 'Réseaux' : 'Social links';
const backToTopLabel = locale === 'fr' ? 'Retour en haut' : 'Back to top';
---

<footer class="border-t border-border-default/70 bg-primary">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 pt-8 md:pt-10 pb-8 flex flex-col gap-5 md:gap-7">
    <!-- Stacked until lg: on tablet the three groups squeezed the title and wrapped the nav -->
    <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-4 lg:gap-8">
      <div class="flex flex-col gap-1">
        <p class="font-heading text-lg font-semibold text-primary">Adonai Nangui</p>
        <p class="text-sm text-secondary">{getTranslation('hero', 'title', locale)}</p>
      </div>

      <nav aria-label={footerNavLabel}>
        <ul class="flex flex-wrap gap-x-5 md:gap-x-7 gap-y-1" role="list">
          {navLinks.map((link) => (
            <li>
              <a href={link.href} class="footer-link flex min-h-11 md:min-h-0 items-center text-sm font-medium">
                {getTranslation('nav', link.key, locale)}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <ul class="flex gap-5 md:gap-7" role="list" aria-label={socialNavLabel}>
        {socialLinks.map((link) => (
          <li>
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="footer-link flex min-h-11 md:min-h-0 items-center text-sm font-medium"
              data-no-external-icon
            >
              {getTranslation('footer', link.key, locale)}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Right padding keeps "back to top" clear of the fixed signature badge until the viewport
         leaves enough margin beside the 1200px container for the badge (~1400px) -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1 sm:gap-4 border-t border-border-default pt-4 md:pt-5 pr-20 sm:pr-24 lg:pr-28 min-[1400px]:pr-0">
      <p class="text-xs md:text-[13px] text-text-tertiary">
        © {currentYear} Adonai Nangui. {copyright}.
      </p>
      <a href="#main-content" class="footer-link flex w-fit min-h-11 md:min-h-0 items-center gap-1 whitespace-nowrap text-[13px] font-medium">
        {backToTopLabel} <span aria-hidden="true">↑</span>
      </a>
    </div>
  </div>
</footer>

<style>
  .footer-link {
    color: var(--color-text-secondary);
  }

  .footer-link:hover {
    color: var(--color-accent);
  }
</style>
