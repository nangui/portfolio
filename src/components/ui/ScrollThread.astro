---
// A thin thread that starts at the top of the home page and unrolls as the visitor scrolls down,
// then winds back up when they scroll up. It wanders like a real thread, with a slow wave and a
// loop now and then, but only through the page's margins and the gaps between sections, so it
// never crosses a line of text.
//
// At the very bottom of the page the thread lets go: its end falls straight down, picking up
// speed, and lands in an untidy heap of coils on the ground.
//
// The host is the closest ancestor marked data-thread-host; it must be positioned.
---

<svg class="scroll-thread" data-scroll-thread aria-hidden="true" focusable="false">
  <path data-thread-path></path>
  <circle data-thread-tip r="2.5"></circle>
</svg>

<style>
  .scroll-thread {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    overflow: visible;
    pointer-events: none;
  }

  .scroll-thread [data-thread-path] {
    fill: none;
    stroke: var(--color-accent-light);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.5;
  }

  .scroll-thread circle {
    fill: var(--color-accent-light);
    opacity: 0;
  }

  .scroll-thread[data-ready='true'] circle {
    opacity: 0.9;
  }
</style>

<script>
  const svg = document.querySelector<SVGSVGElement>('[data-scroll-thread]');
  const host = svg?.closest<HTMLElement>('[data-thread-host]');
  const path = svg?.querySelector<SVGPathElement>('[data-thread-path]');
  const tip = svg?.querySelector<SVGCircleElement>('[data-thread-tip]');

  if (svg && host && path && tip) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const CORNER = 36;
    /** Where the thread's end sits in the viewport, from the top */
    const LEAD = 0.62;
    const STEP = 4;
    /** Straight pieces a rounded corner of the route is measured with */
    const CHORDS = 32;
    /** How far the heap spreads along the ground, and how many coils the fallen thread makes */
    const SPREAD = 120;
    const COILS = 7.5;

    let total = 0;
    // Length of thread paid out at each height of the route. The route only ever goes down or
    // sideways, so a height maps to one length, however much the thread itself loops on the way.
    let heights: number[] = [];
    let lengths: number[] = [];
    // The drawn thread, point by point, alongside `lengths`: its end is read from here
    let xs: number[] = [];
    let ys: number[] = [];
    /** Height where the hanging thread ends: below it, the thread only goes when it falls */
    let hangEnd = 0;
    /** Length paid out when the falling end touches the ground */
    let landing = 0;
    const state = { length: 0 };

    /** Index of the last value at or below `target` in a sorted list */
    const lastAtOrBelow = (values: number[], target: number) => {
      let low = 0;
      let high = values.length - 1;
      while (low < high) {
        const middle = (low + high + 1) >> 1;
        if (values[middle] <= target) low = middle;
        else high = middle - 1;
      }
      return low;
    };

    const draw = () => {
      path.style.strokeDashoffset = String(total - state.length);
      // The end of the thread, between the two drawn points around the length paid out.
      // Asking the browser (getPointAtLength) walks the whole path on every frame.
      const index = lastAtOrBelow(lengths, state.length);
      const next = Math.min(index + 1, lengths.length - 1);
      const span = lengths[next] - lengths[index];
      const share = span > 0 ? Math.min(1, Math.max(0, (state.length - lengths[index]) / span)) : 0;
      tip.setAttribute('cx', (xs[index] + (xs[next] - xs[index]) * share).toFixed(1));
      tip.setAttribute('cy', (ys[index] + (ys[next] - ys[index]) * share).toFixed(1));
    };

    interface Loop {
      at: number;
      span: number;
      radius: number;
    }

    /** What the last build was laid on: the same measures give the same thread */
    let laid = '';

    const build = () => {
      const width = host.clientWidth;
      const height = host.offsetHeight;
      const top = host.getBoundingClientRect().top;

      const sections = [...host.querySelectorAll<HTMLElement>('section[id]')];
      const boundaries = sections.slice(1).map((section) => Math.round(section.getBoundingClientRect().top - top));
      const last = sections[sections.length - 1];
      hangEnd = last ? Math.round(last.getBoundingClientRect().top - top + last.offsetHeight * 0.5) : height - 140;
      // The ground is the bottom of the page's last section, in its empty padding
      const ground = height - 22;

      const measures = [width, height, hangEnd, ...boundaries].join();
      if (measures === laid) return false;
      laid = measures;
      svg.setAttribute('viewBox', `0 0 ${width} ${height}`);
      const start = 28;

      // Just outside the 1200px column, at the window's edge when there is no room, and one
      // straight line down the edge on small screens, which have no margin to wander in
      const margin = width < 1024 ? 6 : Math.max(12, (width - 1200) / 2 - 28);
      // The straight route the thread follows, never drawn: lines and rounded corners, kept as a
      // chain of points with the distance travelled at each one. Measuring it in script rather
      // than through an SVG path spares tens of thousands of getPointAtLength calls per build.
      let x = margin;
      const routeX = [x];
      const routeY = [start];
      const routeAt = [0];
      const lineTo = (toX: number, toY: number) => {
        const from = routeX.length - 1;
        routeAt.push(routeAt[from] + Math.hypot(toX - routeX[from], toY - routeY[from]));
        routeX.push(toX);
        routeY.push(toY);
      };
      // A corner is a quadratic curve: short chords follow it to a few hundredths of a pixel
      const cornerTo = (viaX: number, viaY: number, toX: number, toY: number) => {
        const fromX = routeX[routeX.length - 1];
        const fromY = routeY[routeY.length - 1];
        for (let chord = 1; chord <= CHORDS; chord++) {
          const t = chord / CHORDS;
          const u = 1 - t;
          lineTo(u * u * fromX + 2 * u * t * viaX + t * t * toX, u * u * fromY + 2 * u * t * viaY + t * t * toY);
        }
      };
      if (width >= 1024) {
        const right = width - margin;
        for (const y of boundaries) {
          const next = x === margin ? right : margin;
          const toward = next > x ? 1 : -1;
          // Down to the gap between two sections, across it, and down the other margin
          lineTo(x, y - CORNER);
          cornerTo(x, y, x + toward * CORNER, y);
          lineTo(next - toward * CORNER, y);
          cornerTo(next, y, next, y + CORNER);
          x = next;
        }
      }
      // The fall, then the stretch lying on the ground, toward the middle of the page
      const inward = x > width / 2 ? -1 : 1;
      // The stretch after the landing is only a ruler for the heap, which is drawn from it below
      const lie = 260;
      const spread = Math.min(SPREAD, width * 0.32);
      lineTo(x, ground - 10);
      cornerTo(x, ground, x + inward * 10, ground);
      lineTo(x + inward * lie, ground);

      const route = routeAt[routeAt.length - 1];
      const routePoint = (along: number) => {
        const index = lastAtOrBelow(routeAt, along);
        const next = Math.min(index + 1, routeAt.length - 1);
        const span = routeAt[next] - routeAt[index];
        const share = span > 0 ? Math.min(1, Math.max(0, (along - routeAt[index]) / span)) : 0;
        return { x: routeX[index] + (routeX[next] - routeX[index]) * share, y: routeY[index] + (routeY[next] - routeY[index]) * share };
      };
      const groundFrom = route - lie + 10;

      // How far the thread may stray from its route: the margin it runs in decides
      const wave = Math.min(11, Math.max(2.5, margin - 3));

      // Loops sit on straight stretches only: a loop on a corner would tie a knot
      const straight = (from: number, to: number) => {
        const a0 = routePoint(from);
        const a1 = routePoint(from + STEP);
        const b0 = routePoint(to - STEP);
        const b1 = routePoint(to);
        return Math.abs((a1.x - a0.x) * (b1.y - b0.y) - (a1.y - a0.y) * (b1.x - b0.x)) < 0.01 && (a1.x - a0.x) * (b1.x - b0.x) + (a1.y - a0.y) * (b1.y - b0.y) > 0;
      };
      // A loop crosses over itself only when its span is under about 1.4 times its radius
      const loops: Loop[] = [];
      if (margin >= 44) {
        for (let at = 330; at + 80 < groundFrom - 200; at += 560) {
          if (routePoint(at).y < hangEnd - 40 && straight(at - 50, at + 68)) loops.push({ at, span: 18, radius: 15 });
        }
      }

      // The heap. Thread dropped on the ground coils where it lands: flattened turns of uneven
      // size, leaning this way and that, climbing on each other, drifting slowly away from the
      // landing point, with the loose end trailing out flat. `share` runs 0 -> 1 along it.
      // Every term is a fixed sine, so the heap is the same on each visit and each resize.
      const landingX = x + inward * 10;
      const heap = (share: number): [number, number] => {
        const fade = 1 - Math.min(1, Math.max(0, (share - 0.8) / 0.2)) ** 2;
        const turn = -Math.PI / 2 + Math.PI * 2 * COILS * share ** 0.92;
        const wide = (15 + 6 * Math.sin(9.7 * share + 0.4) + 3.5 * Math.sin(23 * share + 1.1)) * fade;
        const tall = (8 + 3.5 * Math.sin(13.3 * share + 2) + 2 * Math.sin(31 * share)) * fade;
        const rise = tall * (1 + Math.sin(turn));
        // Coils climb on the ones already there, most in the middle of the heap
        const stack = 11 * Math.sin(Math.PI * Math.min(1, share / 0.8)) ** 2 * (0.55 + 0.45 * Math.sin(17 * share + 0.7)) * fade;
        const lean = 0.5 * Math.sin(6.1 * share + 0.9) * rise;
        const centre = spread * share ** 1.25 + 9 * Math.sin(11 * share) * fade * Math.min(1, share * 8);
        return [landingX + inward * (centre + wide * Math.cos(turn) + lean), ground - rise - stack];
      };

      const loopAt = (along: number) => loops.find((loop) => along >= loop.at - STEP && along <= loop.at + loop.span + STEP);
      const points: string[] = [];
      heights = [];
      lengths = [];
      xs = [];
      ys = [];
      landing = 0;
      let paid = 0;
      let lastX = 0;
      let lastY = 0;
      // A loop packs a long turn into a short stretch of route: it is sampled finely to stay round
      for (let along = 0; along <= route; along += along >= groundFrom ? 0.35 : loopAt(along) ? 0.6 : STEP) {
        const here = routePoint(along);
        const ahead = routePoint(Math.min(route, along + 1));
        const behind = routePoint(Math.max(0, along - 1));
        const length = Math.hypot(ahead.x - behind.x, ahead.y - behind.y) || 1;
        const tx = (ahead.x - behind.x) / length;
        const ty = (ahead.y - behind.y) / length;
        const lying = along >= groundFrom;
        // One side of the route throughout, so the sideways direction turns with the corners and
        // never flips mid-stretch. The margins leave 60px between the route and the text: the
        // wave and a loop together take 41 at most.
        const nx = -ty;
        const ny = tx;

        // Two slow waves of different lengths never line up: the thread does not look ruled.
        // It starts on its route and hangs straight while it falls.
        const falling = Math.max(0, Math.min(1, (hangEnd - here.y) / 70));
        const ease = lying ? 0 : Math.min(1, along / 120) * falling;
        const sway = ease * wave * (0.62 * Math.sin(along / 46) + 0.38 * Math.sin(along / 19 + 1.3));
        let x1 = here.x + nx * sway;
        let y1 = here.y + ny * sway;

        const loop = loops.find((candidate) => along >= candidate.at && along <= candidate.at + candidate.span);
        if (loop) {
          // The thread runs on, rises, comes back over itself and goes on: one turn
          const turn = ((along - loop.at) / loop.span) * Math.PI * 2;
          x1 += Math.sin(turn) * loop.radius * tx + (1 - Math.cos(turn)) * loop.radius * nx;
          y1 += Math.sin(turn) * loop.radius * ty + (1 - Math.cos(turn)) * loop.radius * ny;
        }

        if (lying) [x1, y1] = heap((along - groundFrom) / (route - groundFrom));

        if (along > 0) paid += Math.hypot(x1 - lastX, y1 - lastY);
        lastX = x1;
        lastY = y1;
        points.push(`${along ? 'L' : 'M'}${x1.toFixed(1)} ${y1.toFixed(1)}`);
        xs.push(x1);
        ys.push(y1);
        heights.push(here.y);
        lengths.push(paid);
        if (!landing && lying) landing = paid;
      }

      path.setAttribute('d', points.join(''));
      total = path.getTotalLength();
      path.style.strokeDasharray = String(total);
      // The browser measures the drawn curve a little differently from the sum of its chords
      const scale = paid ? total / paid : 1;
      lengths = lengths.map((length) => length * scale);
      landing *= scale;
      svg.dataset.ready = 'true';
      return true;
    };

    // Last sample at or above y
    const lengthAt = (y: number) => (heights[0] > y ? 0 : lengths[lastAtOrBelow(heights, y)]);

    let follow: ((target: number) => void) | null = null;
    let fall: (() => void) | null = null;
    let fallen = false;
    const update = () => {
      if (reducedMotion) {
        state.length = total;
        draw();
        return;
      }
      const atBottom = window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 4;
      if (atBottom && fall) {
        if (!fallen) {
          fallen = true;
          fall();
        }
        return;
      }
      fallen = false;
      // While it hangs, the thread never goes lower than where it lets go
      const top = host.getBoundingClientRect().top;
      const target = lengthAt(Math.min(window.innerHeight * LEAD - top, hangEnd));
      if (follow) follow(target);
      else {
        state.length = target;
        draw();
      }
    };

    const init = async () => {
      build();
      update();
      if (reducedMotion) return;

      const { gsap } = await import('gsap');
      // A crossing between two sections sits at one height: easing the length lets it be drawn
      // rather than appear at once
      follow = (target) => {
        gsap.killTweensOf(state);
        gsap.to(state, { length: target, duration: 0.7, ease: 'power2.out', onUpdate: draw });
      };
      // The fall: faster and faster down to the ground, then the slack coils up where it landed
      fall = () => {
        gsap.killTweensOf(state);
        gsap
          .timeline({ defaults: { onUpdate: draw } })
          .to(state, { length: landing, duration: 0.5, ease: 'power2.in' })
          .to(state, { length: total, duration: 1.6, ease: 'power3.out' });
      };

      window.addEventListener('scroll', update, { passive: true });
      let pending = 0;
      new ResizeObserver(() => {
        // Sections change height when images load or a list expands: lay the thread again.
        // An observer also reports once when it starts, with nothing changed: build() says so.
        cancelAnimationFrame(pending);
        pending = requestAnimationFrame(() => {
          if (!build()) return;
          fallen = false;
          update();
        });
      }).observe(host);
    };

    void init();
  }
</script>
