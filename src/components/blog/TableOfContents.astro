---
import type { MarkdownHeading } from 'astro';
import { defaultLocale, type Locale } from '@i18n/config';

interface Props {
  headings: MarkdownHeading[];
  locale?: Locale;
}

const { headings, locale = defaultLocale } = Astro.props;
const tocTitle = locale === 'fr' ? 'Table des matières' : 'Table of contents';

// Rendered at build time from the Markdown headings (h2 and h3), so the table is part of the
// initial HTML. Injecting it with JavaScript after load pushed the article down (CLS ~0.4).
const tocHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

{tocHeadings.length >= 2 && (
  <details class="toc-details mb-8 bg-secondary/30 border border-border-default rounded-lg overflow-hidden" id="toc-details" open>
    <summary class="cursor-pointer px-4 py-3 hover:bg-secondary/50 transition-colors flex items-center justify-between gap-3 select-none">
      <span class="font-heading font-semibold text-primary flex items-center gap-2">
        <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        {tocTitle}
      </span>
      <svg class="w-5 h-5 text-secondary transition-transform toc-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </summary>
    <nav class="px-4 pb-4" aria-label={tocTitle}>
      <ol class="space-y-2 text-sm">
        {tocHeadings.map((heading) => (
          <li class={heading.depth === 3 ? 'ml-4' : ''}>
            <a
              href={`#${heading.slug}`}
              class="text-secondary hover:text-accent transition-colors block py-1.5 hover:underline"
              data-toc-link
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </details>
)}

<script>
  // Progressive enhancement only: the table is already in the HTML.
  const initTableOfContents = () => {
    const tocDetails = document.getElementById('toc-details');
    if (!tocDetails) return;

    const tocLinks = Array.from(tocDetails.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));

    // Close the table on mobile after choosing a section
    tocLinks.forEach((link) => {
      link.addEventListener('click', () => {
        if (window.innerWidth < 768) tocDetails.removeAttribute('open');
      });
    });

    // Highlight the section currently in view
    const headings = tocLinks
      .map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
      .filter((heading): heading is HTMLElement => Boolean(heading));

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          tocLinks.forEach((link) => link.classList.remove('text-accent', 'font-medium'));
          const activeLink = tocLinks.find((link) => decodeURIComponent(link.hash.slice(1)) === entry.target.id);
          activeLink?.classList.add('text-accent', 'font-medium');
        });
      },
      { rootMargin: '-80px 0px -70% 0px', threshold: 0 }
    );

    headings.forEach((heading) => observer.observe(heading));
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTableOfContents, { once: true });
  } else {
    initTableOfContents();
  }
</script>

<style>
  .toc-details summary {
    list-style: none;
  }

  .toc-details summary::-webkit-details-marker {
    display: none;
  }

  .toc-chevron {
    transition: transform 0.2s ease;
  }

  .toc-details[open] .toc-chevron {
    transform: rotate(0deg);
  }

  .toc-details:not([open]) .toc-chevron {
    transform: rotate(-90deg);
  }

  [data-toc-link] {
    scroll-behavior: smooth;
  }

  /* Smooth scroll offset under the sticky navigation */
  :global(html) {
    scroll-padding-top: 6rem;
  }
</style>
