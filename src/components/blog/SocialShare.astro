---
import { defaultLocale, type Locale } from '@i18n/config';

interface Props {
  title: string;
  url: string;
  description?: string;
  locale?: Locale;
}

const { title, url, description = '', locale = defaultLocale } = Astro.props;

// Encode URLs for sharing
const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);
const encodedDescription = encodeURIComponent(description);

// Social sharing URLs
const twitterUrl = `https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`;
const linkedInUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`;
const emailBody = description ? `${encodedDescription}%0A%0A${encodedUrl}` : encodedUrl;
const emailUrl = `mailto:?subject=${encodedTitle}&body=${emailBody}`;

const shareText = locale === 'fr' ? 'Partager cet article :' : 'Share this post on:';

// One solid glyph per network, all drawn without their own background shape: the circle comes from
// the link itself, so the three icons keep the same weight and size
const links = [
  {
    href: twitterUrl,
    label: 'Share on X',
    title: 'X (Twitter)',
    analytics: 'x',
    external: true,
    path: 'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z',
  },
  {
    href: linkedInUrl,
    label: 'Share on LinkedIn',
    title: 'LinkedIn',
    analytics: 'linkedin',
    external: true,
    path: 'M5.4 4.5a2.4 2.4 0 1 1-4.8 0 2.4 2.4 0 0 1 4.8 0zM.9 9h4.2v12.6H.9V9zm7.05 0h4.03v1.72h.06c.56-1.06 1.93-2.18 3.97-2.18 4.25 0 5.03 2.8 5.03 6.43v6.63h-4.2v-5.88c0-1.4-.03-3.2-1.95-3.2-1.95 0-2.25 1.52-2.25 3.1v5.98h-4.2V9z',
  },
  {
    href: emailUrl,
    label: 'Share via email',
    title: 'Email',
    analytics: 'email',
    external: false,
    path: 'M2.4 6.6c0-1.16.94-2.1 2.1-2.1h15c1.16 0 2.1.94 2.1 2.1v.37l-9.6 5.7-9.6-5.7V6.6zm0 2.8v8c0 1.16.94 2.1 2.1 2.1h15c1.16 0 2.1-.94 2.1-2.1v-8l-9.09 5.4a1.2 1.2 0 0 1-1.22 0L2.4 9.4z',
  },
];
---

<div class="social-share mt-12 mb-8">
  <p class="text-sm text-secondary font-medium mb-4">{shareText}</p>
  <div class="flex flex-wrap items-center gap-2">
    {links.map((link) => (
      <a
        href={link.href}
        target={link.external ? '_blank' : undefined}
        rel={link.external ? 'noopener noreferrer' : undefined}
        class="social-share-link flex justify-center items-center w-10 h-10 rounded-full bg-secondary/30 hover:bg-secondary border border-border-default hover:border-accent transition-all"
        aria-label={link.label}
        title={link.title}
        data-analytics-event="share_click"
        data-analytics-label={link.analytics}
        data-no-external-icon
      >
        <svg
          class="h-[18px] w-[18px] shrink-0 text-secondary"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d={link.path} />
        </svg>
      </a>
    ))}
  </div>
</div>

<style>
  .social-share-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .social-share-link svg {
    display: block;
  }

  .social-share-link:hover svg {
    color: var(--color-accent);
  }

  .social-share-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
</style>
