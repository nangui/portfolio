---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Button from '@components/ui/Button.astro';
import TextDistortion from '@components/ui/TextDistortion.astro';
import OptimizedImage from '@components/ui/OptimizedImage.astro';
import PasteurFlowDiagram from '@components/projects/PasteurFlowDiagram.astro';
import { isValidLocale, defaultLocale } from '@i18n/config';
import { getTranslation } from '@i18n/translations';
import { formatPath } from '@i18n/utils';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  const locales = ['fr', 'en'];

  // Helper to extract locale from filename or slug
  const getLocaleFromId = (entry: CollectionEntry<'projects'>): string | null => {
    // First, check the slug (e.g., "socium-fr" -> "fr")
    if (entry.data.slug) {
      const slugMatch = entry.data.slug.match(/-(fr|en)$/);
      if (slugMatch) {
        return slugMatch[1] as 'fr' | 'en';
      }
    }

    // Fallback: check the filename
    const filename = entry.id.split('/').pop() || entry.id;
    if (/\.fr\.(md|mdx)$/.test(filename)) return 'fr';
    if (/\.en\.(md|mdx)$/.test(filename)) return 'en';
    return null;
  };

  const getSlug = (entry: CollectionEntry<'projects'>) => {
    if (entry.data.slug) {
      // Normalize slug: remove locale suffix if present (e.g., "socium-fr" -> "socium")
      return entry.data.slug.replace(/-(fr|en)$/, '');
    }
    const filename = entry.id.split('/').pop() || entry.id;
    // Remove locale suffix if present (e.g., djoubo.en.md -> djoubo)
    return filename.replace(/\.(fr|en)\.(md|mdx)$/, '').replace(/\.(md|mdx)$/, '');
  };

  // Group projects by slug, but keep track of locale
  const projectsBySlug = new Map<string, CollectionEntry<'projects'>[]>();

  projects.forEach((project: CollectionEntry<'projects'>) => {
    const slug = getSlug(project);
    if (!projectsBySlug.has(slug)) {
      projectsBySlug.set(slug, []);
    }
    projectsBySlug.get(slug)!.push(project);
  });

  const paths: Array<{ params: { locale: string; slug: string }; props: any }> = [];

  projectsBySlug.forEach((projectVariants, slug) => {
    locales.forEach((locale) => {
      // Try to find locale-specific file by checking the slug or ID
      let selectedProject = projectVariants.find(p => {
        const fileLocale = getLocaleFromId(p);
        return fileLocale === locale;
      });

      // Fallback: if no locale-specific file found, try to find a file without locale suffix
      if (!selectedProject) {
        selectedProject = projectVariants.find(p => {
          const fileLocale = getLocaleFromId(p);
          return fileLocale === null; // File without locale suffix
        });
      }

      // Last resort: use the first available file
      if (!selectedProject && projectVariants.length > 0) {
        selectedProject = projectVariants[0];
      }

      if (selectedProject) {
        paths.push({
          params: { locale, slug },
          props: { project: selectedProject, locale },
        });
      }
    });
  });

  return paths;
}

type ProjectData = CollectionEntry<'projects'>['data'];

const { project, locale: localeParam } = Astro.props;
const locale = isValidLocale(localeParam || '') ? localeParam as 'fr' | 'en' : defaultLocale;
const { Content } = await render(project);
const data = project.data as ProjectData;
const projectTitle = locale === 'fr'
  ? (data.title_fr || data.title || '')
  : (data.title_en || data.title || '');
const [projectName, ...subtitleParts] = projectTitle.split(' - ');
const projectSubtitle = subtitleParts.join(' - ');
const projectDescription = locale === 'fr'
  ? (data.description_fr || data.description || '')
  : (data.description_en || data.description || '');
const projectRole = locale === 'fr'
  ? (data.role_fr || data.role || '')
  : (data.role_en || data.role || '');
const projectPeriod = (locale === 'fr'
  ? (data.period_fr || data.period || '')
  : (data.period_en || data.period || '')).replace(' - ', ' – ');
const projectHighlights = (locale === 'fr' ? data.highlights_fr : data.highlights_en) ?? [];
// Structured case study blocks (optional): rendered after the markdown body
const contributions = (locale === 'fr' ? data.contributions_fr : data.contributions_en) ?? [];
const decisions = (locale === 'fr' ? data.decisions_fr : data.decisions_en) ?? [];
const deliveries = locale === 'fr' ? data.deliveries_fr : data.deliveries_en;
const proof = locale === 'fr' ? data.proof_fr : data.proof_en;
const caseLabels = locale === 'fr'
  ? {
      contributions: 'Ce que j’ai conçu et construit',
      decisions: 'Décisions et arbitrages',
      deliveries: 'Les fiches livrées',
      proof: 'La preuve',
      showDetails: 'Voir le détail',
      hideDetails: 'Masquer le détail',
    }
  : {
      contributions: 'What I designed and built',
      decisions: 'Decisions and trade-offs',
      deliveries: 'The forms delivered',
      proof: 'The proof',
      showDetails: 'See details',
      hideDetails: 'Hide details',
    };
const projectImages = data.images?.length
  ? data.images
  : data.image
    ? [data.image]
    : [];
// Projects with a hand-drawn cover instead of screenshots
const hasDiagramCover = Astro.params.slug === 'institut-pasteur-dakar';
const siteUrl = String(Astro.site || 'https://adonainangui.dev').replace(/\/$/, '');
const primaryImage = data.image || data.images?.[0];
const ogImage = primaryImage
  ? `${siteUrl}${primaryImage.startsWith('/') ? primaryImage : `/${primaryImage}`}`
  : undefined;
const pageKeywords = [...data.stack, projectRole, 'frontend project', locale === 'fr' ? 'portfolio développeur' : 'developer portfolio'].filter(Boolean);
const stackLabel = locale === 'fr' ? 'Technologies utilisées' : 'Technologies used';
---

<BaseLayout
  title={`${projectTitle} - Adonai Nangui`}
  description={projectDescription}
  locale={locale}
  ogImage={ogImage}
  keywords={pageKeywords}
>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-16">
    <nav class="mb-8 md:mb-10" aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-sm text-secondary">
        <li>
          <a href={formatPath('/', locale)} class="hover:text-accent transition-colors">
            {getTranslation('nav', 'home', locale)}
          </a>
        </li>
        <li class="text-secondary/60" aria-hidden="true">/</li>
        <li>
          <a href={formatPath('/#projects', locale)} class="hover:text-accent transition-colors">
            {getTranslation('nav', 'projects', locale)}
          </a>
        </li>
        <li class="text-secondary/60" aria-hidden="true">/</li>
        <li class="text-primary truncate max-w-[200px] sm:max-w-[300px] md:max-w-none" aria-current="page">
          {projectName}
        </li>
      </ol>
    </nav>

    <header class="mb-10 md:mb-14">
      <TextDistortion animateOnLoad={true}>
        <h1 class="font-heading font-semibold text-3xl sm:text-4xl lg:text-5xl leading-[1.1] tracking-[-0.02em] text-primary">
          {projectName}
        </h1>
      </TextDistortion>
      {projectSubtitle && (
        <p class="mt-2 font-heading text-lg sm:text-xl lg:text-2xl leading-snug text-secondary">
          {projectSubtitle}
        </p>
      )}

      <p class="mt-5 md:mt-6 text-base sm:text-lg md:text-xl leading-relaxed text-secondary">
        {projectDescription}
      </p>

      {(projectRole || projectPeriod) && (
        <dl class="mt-7 md:mt-8 grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6 border-y border-border-default py-5 md:py-6">
          {projectRole && (
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
              <div>
                <dt class="text-xs text-secondary/60 uppercase tracking-wide mb-1">
                  {getTranslation('projects', 'role', locale)}
                </dt>
                <dd class="text-primary font-medium">{projectRole}</dd>
              </div>
            </div>
          )}
          {projectPeriod && (
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <div>
                <dt class="text-xs text-secondary/60 uppercase tracking-wide mb-1">
                  {getTranslation('projects', 'period', locale)}
                </dt>
                <dd class="text-primary font-medium">{projectPeriod}</dd>
              </div>
            </div>
          )}
        </dl>
      )}

      {projectHighlights.length > 0 && (
        <dl class="mt-6 md:mt-7 grid grid-cols-3 gap-3 sm:gap-6">
          {projectHighlights.map((highlight) => (
            <div class="flex flex-col-reverse justify-end gap-1">
              <dt class="text-xs sm:text-sm leading-snug text-secondary">{highlight.label}</dt>
              <dd class="font-heading text-2xl sm:text-3xl font-semibold text-primary">{highlight.value}</dd>
            </div>
          ))}
        </dl>
      )}

      <ul class="mt-6 md:mt-7 flex flex-wrap gap-2" aria-label={stackLabel}>
        {data.stack.map((tech: string) => (
          <li class="px-3 py-1.5 bg-secondary/50 border border-border-default rounded-full text-xs sm:text-sm text-secondary whitespace-nowrap">
            {tech}
          </li>
        ))}
      </ul>

      {(data.demoUrl || data.githubUrl) && (
        <div class="mt-6 md:mt-8 flex flex-wrap gap-3 sm:gap-4">
          {data.demoUrl && (
            <Button
              href={data.demoUrl}
              variant="primary"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg class="w-4 h-4 inline-block mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
              {getTranslation('projects', 'viewDemo', locale)}
            </Button>
          )}
          {data.githubUrl && (
            <Button
              href={data.githubUrl}
              variant="secondary"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg class="w-4 h-4 inline-block mr-2" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
              {getTranslation('projects', 'viewSource', locale)}
            </Button>
          )}
        </div>
      )}
    </header>

    {hasDiagramCover ? (
      <div class="project-cover mb-12 md:mb-16 flex min-h-[176px] items-center justify-center rounded-lg border border-border-default p-6 md:p-10">
        <PasteurFlowDiagram locale={locale} />
      </div>
    ) : projectImages.length > 0 && (
      <div class="mb-12 md:mb-16 space-y-6">
        {projectImages.map((img: string, index: number) => (
          <OptimizedImage
            src={img}
            alt={projectImages.length > 1 ? `${projectName} - Image ${index + 1}` : projectName}
            class="w-full h-auto rounded-lg border border-border-default shadow-lg object-cover"
            loading={index === 0 ? 'eager' : 'lazy'}
            quality={90}
          />
        ))}
      </div>
    )}

    <div class="prose max-w-none text-secondary leading-relaxed">
      <Content />
    </div>

    {contributions.length > 0 && (
      <section class="mt-14 md:mt-16" aria-labelledby="case-contributions-heading">
        <h2 id="case-contributions-heading" class="case-heading">{caseLabels.contributions}</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {contributions.map((contribution) => (
            <article class="flex flex-col gap-2.5 rounded-xl border border-border-default bg-secondary p-5 md:p-[22px]">
              <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
                <h3 class="font-heading text-lg font-semibold leading-snug text-primary">{contribution.title}</h3>
                {contribution.share && (
                  <span class="text-[13px] text-accent whitespace-nowrap">{contribution.share}</span>
                )}
              </div>
              {contribution.role && (
                <p class="text-xs uppercase tracking-wide text-text-tertiary">{contribution.role}</p>
              )}
              <p class="text-[15px] leading-relaxed text-secondary">{contribution.summary}</p>
              {contribution.stack && contribution.stack.length > 0 && (
                <ul class="flex flex-wrap gap-1.5" aria-label={stackLabel}>
                  {contribution.stack.map((tech) => (
                    <li class="rounded-full border border-border-default bg-bg-tertiary px-2.5 py-1 text-xs text-secondary">
                      {tech}
                    </li>
                  ))}
                </ul>
              )}
              {contribution.details && contribution.details.length > 0 && (
                <details class="case-details mt-1">
                  <summary class="flex min-h-11 md:min-h-0 w-fit cursor-pointer items-center text-sm font-medium text-accent hover:text-accent-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">
                    <span class="case-details-show">{caseLabels.showDetails} ({contribution.details.length})</span>
                    <span class="case-details-hide">{caseLabels.hideDetails}</span>
                  </summary>
                  <ul class="mt-3 flex flex-col gap-2.5">
                    {contribution.details.map((detail) => (
                      <li class="flex items-start gap-2.5 text-sm leading-relaxed text-secondary">
                        <span class="mt-2 h-1.5 w-1.5 rounded-full bg-accent shrink-0" aria-hidden="true"></span>
                        <span><strong class="font-semibold text-primary">{detail.title}</strong>{detail.text}</span>
                      </li>
                    ))}
                  </ul>
                </details>
              )}
            </article>
          ))}
        </div>
      </section>
    )}

    {decisions.length > 0 && (
      <section class="mt-14 md:mt-16" aria-labelledby="case-decisions-heading">
        <h2 id="case-decisions-heading" class="case-heading">{caseLabels.decisions}</h2>
        <dl class="border-t border-border-default">
          {decisions.map((decision) => (
            <div class="grid grid-cols-1 md:grid-cols-[240px_minmax(0,1fr)] gap-2 md:gap-8 border-b border-border-default py-5 md:py-6">
              <dt class="font-heading text-[17px] font-semibold leading-snug text-primary">{decision.title}</dt>
              <dd class="text-base leading-[1.7] text-secondary">{decision.text}</dd>
            </div>
          ))}
        </dl>
      </section>
    )}

    {deliveries && deliveries.items.length > 0 && (
      <section class="mt-14 md:mt-16" aria-labelledby="case-deliveries-heading">
        <h2 id="case-deliveries-heading" class="case-heading">{caseLabels.deliveries}</h2>
        {deliveries.intro && (
          <p class="text-base md:text-lg leading-[1.7] text-secondary">{deliveries.intro}</p>
        )}
        <ul class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-4">
          {deliveries.items.map((item) => (
            <li class="flex flex-col gap-2 rounded-xl border border-border-default bg-secondary p-5">
              <h3 class="font-heading text-[17px] font-semibold leading-snug text-primary">{item.title}</h3>
              <p class="text-[15px] leading-relaxed text-secondary">{item.text}</p>
            </li>
          ))}
        </ul>
        {deliveries.outro && (
          <p class="mt-6 text-base md:text-lg leading-[1.7] text-secondary">{deliveries.outro}</p>
        )}
      </section>
    )}

    {proof && (
      <section class="mt-14 md:mt-16 flex flex-col gap-3.5 rounded-xl border border-accent bg-secondary p-6 md:p-9" aria-labelledby="case-proof-heading">
        <h2 id="case-proof-heading" class="text-xs font-semibold uppercase tracking-[0.08em] text-accent">{caseLabels.proof}</h2>
        {proof.intro && <p class="text-sm text-secondary">{proof.intro}</p>}
        <p class="font-heading text-xl md:text-[26px] leading-[1.35] text-primary">{proof.lead}</p>
        {proof.text && <p class="text-base leading-[1.7] text-secondary">{proof.text}</p>}
        {proof.note && (
          <p class="mt-1 border-t border-border-default pt-3.5 text-sm leading-relaxed text-text-tertiary">{proof.note}</p>
        )}
      </section>
    )}
  </article>
</BaseLayout>

<style>
  .project-cover {
    background-color: var(--color-bg-primary);
    background-image:
      linear-gradient(color-mix(in srgb, var(--color-border-light) 25%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--color-border-light) 25%, transparent) 1px, transparent 1px);
    background-size: 32px 32px;
  }

  .case-heading {
    margin-bottom: 1.25rem;
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: var(--font-weight-semibold);
    line-height: 1.25;
    color: var(--color-text-primary);
  }

  @media (min-width: 768px) {
    .case-heading {
      margin-bottom: 1.5rem;
      font-size: 1.875rem;
    }
  }

  .case-details summary {
    list-style: none;
  }

  .case-details summary::-webkit-details-marker {
    display: none;
  }

  .case-details-hide,
  .case-details[open] .case-details-show {
    display: none;
  }

  .case-details[open] .case-details-hide {
    display: inline;
  }

  /* Markdown output is rendered by <Content />, outside this component's scope: target it with :global() */
  .prose {
    color: var(--color-text-secondary);
  }

  .prose :global(h2),
  .prose :global(h3),
  .prose :global(h4) {
    color: var(--color-text-primary);
    font-family: var(--font-heading);
    font-weight: var(--font-weight-semibold);
    line-height: 1.25;
  }

  .prose :global(h2) {
    font-size: 1.5rem;
  }

  .prose :global(h3) {
    font-size: 1.25rem;
  }

  @media (min-width: 768px) {
    .prose :global(h2) {
      font-size: 1.875rem;
    }

    .prose :global(h3) {
      font-size: 1.375rem;
    }
  }

  .prose :global(strong) {
    color: var(--color-text-primary);
    font-weight: var(--font-weight-semibold);
  }

  .prose :global(a) {
    color: var(--color-accent);
    text-decoration: none;
  }

  .prose :global(a:hover) {
    color: var(--color-accent-hover);
    text-decoration: underline;
  }

  .prose :global(ul) {
    list-style: disc;
  }

  .prose :global(ol) {
    list-style: decimal;
  }

  .prose :global(li::marker) {
    color: var(--color-accent);
  }

  .prose :global(:not(pre) > code) {
    display: inline-block;
    background-color: var(--color-bg-tertiary);
    border: 1px solid var(--color-border-default);
    color: var(--color-text-primary);
    padding: 0.0625rem 0.4rem;
    border-radius: 0.375rem;
    font-size: 0.85em;
    line-height: 1.5;
  }

  .prose :global(pre) {
    background-color: var(--color-bg-secondary);
    padding: 1rem;
    border-radius: 0.5rem;
    overflow-x: auto;
  }

  .prose :global(pre code) {
    background-color: transparent;
    padding: 0;
  }

  .prose :global(blockquote) {
    border-left: 4px solid var(--color-accent);
    padding-left: 1.25rem;
    margin-left: 0;
    font-family: var(--font-heading);
    font-size: 1.25rem;
    line-height: 1.5;
    color: var(--color-text-primary);
  }
</style>
