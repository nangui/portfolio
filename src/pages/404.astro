---
import BaseLayout from '@layouts/BaseLayout.astro';

// Served by Vercel for every unknown URL, whatever its language: French first, with an English way out
const links = [
  { href: '/fr', label: "Retour à l'accueil", primary: true },
  { href: '/fr#projects', label: 'Voir les projets' },
  { href: '/fr/blog', label: 'Lire le blog' },
];
---

<BaseLayout
  title="Page introuvable - Adonai Nangui"
  description="Cette page n'existe pas ou a été déplacée."
  locale="fr"
  noindex
>
  <section class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 py-20 md:py-28" aria-labelledby="not-found-heading">
    <p class="text-sm font-semibold uppercase tracking-[0.08em] text-accent">Erreur 404</p>
    <h1 id="not-found-heading" class="mt-3 font-heading font-semibold text-4xl md:text-5xl text-primary">
      Cette page n'existe pas
    </h1>
    <p class="mt-4 max-w-[560px] text-lg leading-relaxed text-secondary">
      Le lien est peut-être ancien, ou l'adresse contient une faute de frappe.
    </p>
    <p lang="en" class="mt-2 text-sm text-text-tertiary">
      Page not found. <a href="/en" class="text-accent underline underline-offset-2 hover:text-accent-hover">Go to the English version</a>
    </p>

    <ul class="mt-9 flex flex-col sm:flex-row sm:flex-wrap gap-3" role="list">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              'inline-flex min-h-12 items-center justify-center rounded-lg px-6 text-base font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent',
              link.primary
                ? 'not-found-primary text-white'
                : 'border border-border-default bg-secondary text-primary hover:border-border-light',
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  /* Same blue as the other primary CTAs: #2563eb keeps white text at 5:1 */
  .not-found-primary {
    background: #2563eb;
  }

  .not-found-primary:hover {
    background: #1d4ed8;
  }
</style>
