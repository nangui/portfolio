---
import { getCollection } from 'astro:content';
import { defaultLocale } from '@i18n/config';

// Legacy unprefixed URLs (/projects/<slug>-fr): the localized page lives at /<locale>/projects/<slug>
export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => {
    const filename = project.id.split('/').pop() || project.id;
    const slug = project.data.slug || filename.replace(/\.(md|mdx)$/, '');
    return { params: { slug } };
  });
}

const { slug = '' } = Astro.params;
const locale = slug.match(/[-.](fr|en)$/)?.[1] ?? defaultLocale;
const baseSlug = slug.replace(/[-.](fr|en)$/, '');

return Astro.redirect(`/${locale}/projects/${baseSlug}`, 301);
---
